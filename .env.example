# Optional local data workspace. Relative paths resolve from the repository root.
LOCAL_RESEARCH_DATA_DIR=./.local_data

# Local default: leave both model settings empty to use offline extractive research.
# For a local Ollama server, use its OpenAI-compatible endpoint and a model that supports tools.
# LOCAL_RESEARCH_LLM_BASE_URL=http://127.0.0.1:11434/v1
# LOCAL_RESEARCH_LLM_MODEL=qwen2.5:7b
# LOCAL_RESEARCH_LLM_API_KEY=

# If you configure a remote provider, use HTTPS. Its API key is stored only in this ignored file.
# The app requires an explicit per-question consent checkbox before sending question/evidence remotely.
# LOCAL_RESEARCH_LLM_BASE_URL=https://api.openai.com/v1
# LOCAL_RESEARCH_LLM_MODEL=gpt-4.1-mini
# LOCAL_RESEARCH_LLM_API_KEY=replace-with-your-own-key

# Local-only default. Use 0.0.0.0 only when running behind a trusted preview proxy.
LOCAL_RESEARCH_HOST=127.0.0.1
LOCAL_RESEARCH_PORT=8000
LOCAL_RESEARCH_MAX_STEPS=6
LOCAL_RESEARCH_LLM_TIMEOUT_SECONDS=45
